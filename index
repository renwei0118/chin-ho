let gameState = loadGameState();

function loadGameState() {
  try {
    const saved = localStorage.getItem("seventh_attendance_save_v92");
    if (saved) {
      const parsed = JSON.parse(saved);
      return { ...DEFAULT_STATE, ...parsed, puzzles: { ...DEFAULT_STATE.puzzles, ...(parsed.puzzles || {}) } };
    }
  } catch (e) {}
  return JSON.parse(JSON.stringify(DEFAULT_STATE));
}

function saveGameState() {
  try {
    localStorage.setItem("seventh_attendance_save_v92", JSON.stringify(gameState));
    const ind = document.getElementById("save-indicator");
    if (ind) {
      ind.textContent = "寫入中...";
      setTimeout(() => {
        if (gameState.stage === 3) {
          ind.style.color = "#ff6666";
          ind.textContent = "已讀取你 (16:17)";
        } else {
          ind.style.color = "#a8ff9e";
          ind.textContent = "已同步";
        }
      }, 400);
    }
  } catch (e) {}
}

function confirmResetGame() {
  if (confirm("確定要清除本機快取並重置這份 2003 年網頁快照嗎？")) {
    localStorage.removeItem("seventh_attendance_save_v92");
    gameState = JSON.parse(JSON.stringify(DEFAULT_STATE));
    const overlay = document.getElementById("ending-overlay");
    overlay.style.display = "none"; overlay.className = "";
    document.body.className = "stage-1";
    document.title = "台中縣立青禾國民中學 全球資訊網 - 2003年度存檔";
    addSysLog("快取已清除，重新載入原始網頁快照。", "warn");
    updateAllUI(); navigateTo("home");
  }
}

function addSysLog(msg, type = "normal") {
  const box = document.getElementById("ui-sys-log");
  if (!box) return;
  const line = document.createElement("div");
  if (type === "err") line.className = "err";
  if (type === "warn") line.className = "warn";
  const now = new Date();
  const ts = `${String(now.getHours()).padStart(2,"0")}:${String(now.getMinutes()).padStart(2,"0")}:${String(now.getSeconds()).padStart(2,"0")}`;
  line.textContent = `[${ts}] ${msg}`;
  box.appendChild(line); box.scrollTop = box.scrollHeight;
}

function updateAtmosphere() {
  document.body.className = `stage-${Math.min(5, gameState.stage)}`;
  const conn = document.getElementById("header-conn-status");
  const vPrefix = document.getElementById("visitor-prefix");
  const vSuffix = document.getElementById("visitor-suffix");
  const vCounter = document.getElementById("visitor-counter");
  const saveInd = document.getElementById("save-indicator");

  if (gameState.stage === 1) {
    conn.innerHTML = "● 伺服器狀態：一般唯讀存檔";
    if (vPrefix) vPrefix.textContent = "您是第";
    if (vSuffix) vSuffix.textContent = "位訪客";
    if (saveInd) { saveInd.style.color = "#a8ff9e"; saveInd.textContent = "已同步"; }
  } else if (gameState.stage === 2) {
    conn.innerHTML = "● 伺服器狀態：<span style='color:#ffdd77;'>偵測到未釋放磁區 (0x2032)</span>";
  } else if (gameState.stage === 3) {
    conn.innerHTML = `● 伺服器狀態：<span style='color:#ff6666;'>外部終端機連線 [${getRealTimestamp()}]</span>`;
    if (vPrefix) vPrefix.innerHTML = "<span style='color:#990000; font-weight:bold;'>歡迎新同學，你是第</span>";
    if (vCounter) { vCounter.style.color = "#ff3333"; vCounter.textContent = "000032"; }
    if (vSuffix) vSuffix.innerHTML = "<span style='color:#990000; font-weight:bold;'>號座位遞補者</span>";
    if (saveInd) { saveInd.style.color = "#ff6666"; saveInd.textContent = "已讀取你 (16:17)"; }
  } else {
    conn.innerHTML = "● 伺服器狀態：<span style='color:#ff4444;'>歷史封存紀錄遭到覆寫</span>";
    if (vPrefix) vPrefix.textContent = "您是第";
    if (vCounter) { vCounter.style.color = "#33ff33"; vCounter.textContent = String(gameState.visitorCount).padStart(6, "0"); }
    if (vSuffix) vSuffix.textContent = "位訪客";
    if (saveInd) { saveInd.style.color = "#a8ff9e"; saveInd.textContent = "已同步"; }
  }
}

function addClue(clueObj) {
  if (!clueObj) return;
  if (gameState.clues.some(c => c.id === clueObj.id)) return;
  gameState.clues.push(clueObj);
  RetroAudio.playBeep(660, 0.06, "sine", 0.03);
  addSysLog(`已寫入剪貼簿：${clueObj.id}`, "warn");
  saveGameState(); updateNotebookUI();
}

function checkProgression() {
  const p = gameState.puzzles;
  let newStage = 1;
  if (p.rosterChecked) newStage = 2;
  if (p.deskVerified) newStage = 3;
  if (p.studentPortalOpen) newStage = 4;
  if (p.adminLoggedIn) newStage = 5;

  if (newStage > gameState.stage) {
    gameState.stage = newStage;
    if (newStage === 3) {
      RetroAudio.playCreepyWhisperTone();
      addSysLog(`[ACTIVE_USER] 偵測到外部終端機於 ${getRealTimestamp()} 正在窺視此頁面`, "err");
    } else {
      RetroAudio.playBeep(440, 0.15, "sawtooth", 0.04);
    }
    addSysLog(`磁區索引位址變更 -> 0x0${newStage}`, "err");
    updateAtmosphere();
  }
  saveGameState(); updateNotebookUI();
}

