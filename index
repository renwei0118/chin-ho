function navigateByUrl() {
  const raw = (document.getElementById("ie-url-bar").value || "").trim().toLowerCase();
  if (raw.includes("/temp_old")) {
    gameState.puzzles.tempDirVisited = true;
    addClue({ id: "clue_temp_old", text: "【伺服器保留目錄】透過網址列手動輸入路徑連入 /2003_backup/temp_old/，取得被撤下首頁連結的導師隨筆與作文備份。" });
    addSysLog("IIS 目錄瀏覽授權通過：/2003_backup/temp_old/", "warn");
    saveGameState();
    navigateTo("temp_old");
    return;
  }
  if (raw.includes("/backup_2032")) {
    navigateTo("admin");
    return;
  }
  const matchedPage = Object.keys(PAGE_URLS).find(k => PAGE_URLS[k].toLowerCase() === raw);
  if (matchedPage) {
    navigateTo(matchedPage);
  } else {
    showRetroAlert("HTTP 404 - 找不到網頁", `伺服器找不到路徑：<br><code>${raw.replace(/</g,"&lt;")}</code><br><br>請確認網址拼字或參閱資訊組目錄遷移公告。`, true);
  }
}

