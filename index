let stubbornCloseAttempts = 0;
let activeDocId = null;
let morphTimer = null;

function spawnCascadePopups() {
  const messages = ["無 法 刪 除", "我 在 這 裡", "叫 我 的 名 字"];
  messages.forEach((txt, idx) => {
    setTimeout(() => {
      const div = document.createElement("div");
      div.className = "cascade-popup";
      div.style.left = `${22 + idx * 7}%`;
      div.style.top = `${26 + idx * 8}%`;
      div.innerHTML = `
        <div class="win-titlebar" style="background:linear-gradient(90deg, #6b0000, #c43b3b);">
          <span>系統錯誤 0x2032</span>
          <button class="win-close-btn" onclick="this.closest('.cascade-popup').remove()">✕</button>
        </div>
        <div style="padding:14px; text-align:center; font-weight:bold; color:#800000; letter-spacing:3px;">
          ${txt}
        </div>
      `;
      document.body.appendChild(div);
      RetroAudio.playBeep(320 - idx * 40, 0.09, "sawtooth", 0.05);
    }, idx * 240);
  });
}

function openDocument(docId) {
  const doc = DOCUMENTS[docId];
  if (!doc) return;
  activeDocId = docId;
  stubbornCloseAttempts = 0;
  clearTimeout(morphTimer);

  if (!gameState.readDocs.includes(docId)) gameState.readDocs.push(docId);
  if (doc.onReadClue) addClue(doc.onReadClue);

  const winEl = document.getElementById("doc-window");
  winEl.style.transform = "translate(0, 0)";

  document.getElementById("doc-win-title").textContent = `${doc.filename} - 檔案檢視器`;
  document.getElementById("doc-win-body").innerHTML = `
    <div class="doc-meta-header">
      <div><strong>文件標題：</strong>${wrapName(doc.title)}</div>
      <div><strong>作者 / 來源：</strong>${wrapName(doc.author)}</div>
      <div><strong>建檔日期：</strong>${doc.date} ｜ <strong>分類：</strong>${doc.category}</div>
    </div>
    <div>${wrapName(doc.content)}</div>
  `;
  document.getElementById("doc-win-status").textContent = `檔案名稱：${doc.filename} ｜ 狀態：唯讀`;
  document.getElementById("doc-modal-backdrop").style.display = "flex";

  if (gameState.stage >= 2 && (docId === "my_seat" || docId === "class_diary_0915")) {
    morphTimer = setTimeout(() => {
      const targetP = document.getElementById(docId === "my_seat" ? "morph-para-seat" : "morph-para-diary");
      if (targetP && document.getElementById("doc-modal-backdrop").style.display === "flex") {
        const origHtml = targetP.innerHTML;
        targetP.style.color = "#990000";
        targetP.style.fontWeight = "bold";
        targetP.innerHTML = "  你看得見我對不對？不要把視窗關掉……最後一排靠窗的位置好冷，你願意代替我坐在這裡嗎？";
        RetroAudio.playCreepyWhisperTone();
        setTimeout(() => {
          if (targetP) {
            targetP.style.color = "";
            targetP.style.fontWeight = "";
            targetP.innerHTML = origHtml;
          }
        }, 2800);
      }
    }, 3200);
  }

  saveGameState(); updateNotebookUI(); renderCurrentPage();
}

function attemptCloseDocModal() {
  if (gameState.stage >= 3 && activeDocId === "teacher_memo_1010" && stubbornCloseAttempts < 2) {
    stubbornCloseAttempts++;
    const winEl = document.getElementById("doc-window");
    const offsetX = stubbornCloseAttempts === 1 ? -35 : 42;
    const offsetY = stubbornCloseAttempts === 1 ? 24 : -28;
    winEl.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
    if (stubbornCloseAttempts === 1) spawnCascadePopups();
    else RetroAudio.playBeep(200, 0.14, "sawtooth", 0.05);
    return;
  }
  clearTimeout(morphTimer);
  activeDocId = null;
  document.getElementById("doc-modal-backdrop").style.display = "none";
}

