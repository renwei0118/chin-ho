  const isRead = gameState.readDocs.includes(id);
  return `<button class="doc-link ${isRead ? 'read' : ''}" onclick="openDocument('${id}')">
    <span>${label || doc.filename}</span>
    <span style="font-size:11px; color:#666; font-weight:normal;">${isRead ? '[已讀]' : ''}</span>
  </button>`;
}

