function applyDomModification() {
  const editor = document.getElementById("dom-code-editor");
  if (!editor) return;
  const code = editor.value;

  const lockRemoved = /data-lock\s*=\s*["']false["']/i.test(code);
  const disabledRemoved = !/\bdisabled\b/i.test(code);

  if (lockRemoved && disabledRemoved) {
    gameState.puzzles.adminButtonUnlocked = true;
    addClue({ id: "clue_dom_unlocked", text: "【DOM 屬性覆寫】透過除錯控制台修改 HTML 屬性，成功解除了點名補登按鈕的行政鎖定！" });
    addSysLog("[DOM_OVERRIDE] #btn-true-end 屬性已覆寫：disabled=false", "warn");
    saveGameState();
    document.getElementById("doc-modal-backdrop").style.display = "none";
    renderCurrentPage();
    showRetroAlert("DOM 屬性套用成功", "已成功覆寫網頁表單屬性！<br>「✔ 補登學籍並確認出席」按鈕已解除鎖定，請輸入 <strong>2032</strong> 與 <strong>林以安</strong> 完成點名。");
  } else {
