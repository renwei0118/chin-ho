function renderSearchResultsPage(container) {
  const q = (gameState.lastSearchQuery || "").trim();
  const qLower = q.toLowerCase();

  const matchedDocs = Object.values(DOCUMENTS).filter(d => {
    if ((d.minStage || 1) > gameState.stage) return false;
    if (d.requiresTempDir && !gameState.puzzles.tempDirVisited) return false;
    if (d.requiresPortal && !gameState.puzzles.studentPortalOpen) return false;
    const hay = (d.filename + d.title + d.author + d.content).toLowerCase();
    return hay.includes(qLower);
  });

  container.innerHTML = `
    <div class="breadcrumb"><span>現在位置：首頁 &gt; 站內全文檢索</span><span>關鍵字：「${q.replace(/</g,"&lt;")}」</span></div>
