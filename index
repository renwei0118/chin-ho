<title>台中縣立青禾國民中學 全球資訊網 - 2003年度存檔</title>
<style>
  /* =========================================================
     2003年 台灣國中校園網站復古樣式 (IE6 / Windows XP 經典風格)
     純網頁 ARG 網路調查 / 假網址必經 / DOM修改器真結局版 v9.2
     ========================================================= */
  :root {
    --bg-main: #d8d5c8;
    --bg-panel: #f4f1e6;
    --bg-box: #e9e6da;
    --nav-blue: #1a3b6e;
    --nav-blue-light: #336699;
    --warn-red: #990000;
    --text-dark: #222222;
    --text-muted: #555555;
    --border-light: #ffffff;
    --border-dark: #808080;
    --border-darker: #404040;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--bg-main);
    background-image: radial-gradient(#c4c0b0 1px, transparent 1px);
    background-size: 16px 16px;
    color: var(--text-dark);
    font-family: "新細明體", "PMingLiU", "MingLiU", "Noto Serif TC", serif;
    font-size: 14px;
    line-height: 1.6;
    overflow-x: hidden;
    transition: filter 0.6s ease, background-color 1s ease;
  }

  #crt-overlay {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.06) 50%);
    background-size: 100% 3px;
    pointer-events: none;
    z-index: 9998;
    opacity: 0.32;
    transition: opacity 1s ease, box-shadow 1s ease;
  }

  body.stage-1 #crt-overlay { opacity: 0.32; }
  body.stage-2 { background-color: #cfcbba; }
  body.stage-2 #crt-overlay {
    opacity: 0.48;
    box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.25);
  }
  body.stage-3 {
    background-color: #a89f91;
    background-image: radial-gradient(#756860 1px, transparent 1px);
  }
  body.stage-3 #crt-overlay {
    opacity: 0.78;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(55, 0, 0, 0.18) 50%);
    background-size: 100% 3px;
    box-shadow: inset 0 0 110px rgba(45, 0, 0, 0.55);
  }
  body.stage-3 .panel {
    box-shadow: 2px 2px 8px rgba(45, 0, 0, 0.35);
    border-color: #6b5858;
  }
  body.stage-4, body.stage-5 {
    background-color: #968e82;
    animation: screenGlitch 8s infinite;
  }
  body.stage-4 #crt-overlay, body.stage-5 #crt-overlay {
    opacity: 0.82;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(60, 0, 0, 0.2) 50%);
    background-size: 100% 3px;
    box-shadow: inset 0 0 90px rgba(20, 0, 0, 0.5);
  }

  @keyframes screenGlitch {
    0%, 93%, 100% { filter: none; }
    94% { filter: contrast(1.28) brightness(0.9) hue-rotate(-5deg); }
    96% { filter: invert(0.06) contrast(1.4); }
    98% { filter: none; }
  }

  @keyframes violentShake {
    0% { transform: translate(0, 0) skew(0deg); filter: invert(0); }
    20% { transform: translate(-8px, 4px) skew(-2deg); filter: invert(0.8) contrast(2); }
    40% { transform: translate(8px, -6px) skew(3deg); filter: hue-rotate(90deg) contrast(1.8); }
    60% { transform: translate(-6px, -4px) skew(-1deg); filter: invert(0.9); }
    80% { transform: translate(6px, 6px) skew(2deg); filter: contrast(2.5) brightness(0.6); }
    100% { transform: translate(0, 0) skew(0deg); filter: invert(0); }
  }

  .violent-glitch { animation: violentShake 0.18s infinite !important; }

  .haunted-name {
    display: inline-block;
    transition: color 0.2s;
  }
  body.stage-2 .haunted-name:hover,
  body.stage-3 .haunted-name:hover,
  body.stage-4 .haunted-name:hover,
  body.stage-5 .haunted-name:hover {
    color: #990000;
    font-weight: bold;
    animation: nameShiver 0.12s infinite;
  }
  @keyframes nameShiver {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-1px, 1px); }
    50% { transform: translate(1px, -1px); }
    75% { transform: translate(-1px, -1px); }
    100% { transform: translate(1px, 1px); }
  }

  .bevel-out {
    border-top: 2px solid var(--border-light); border-left: 2px solid var(--border-light);
    border-right: 2px solid var(--border-dark); border-bottom: 2px solid var(--border-dark);
  }
  .bevel-in {
    border-top: 2px solid var(--border-dark); border-left: 2px solid var(--border-dark);
    border-right: 2px solid var(--border-light); border-bottom: 2px solid var(--border-light);
  }

  button, .retro-btn {
    font-family: "新細明體", "PMingLiU", sans-serif; font-size: 13px;
    background-color: #d4d0c8; color: #000000;
    border-top: 2px solid #ffffff; border-left: 2px solid #ffffff;
    border-right: 2px solid #404040; border-bottom: 2px solid #404040;
    padding: 3px 10px; cursor: pointer;
  }
  button:active:not(:disabled), .retro-btn:active:not(:disabled) {
    border-top: 2px solid #404040; border-left: 2px solid #404040;
    border-right: 2px solid #ffffff; border-bottom: 2px solid #ffffff;
    padding: 4px 9px 2px 11px;
  }
  button:hover:not(:disabled) { background-color: #dfdcd4; }
  button:disabled {
    color: #808080 !important;
    background-color: #cccccc !important;
    cursor: not-allowed;
    text-shadow: 1px 1px 0 #fff;
  }

  input[type="text"], input[type="password"], textarea, select {
    font-family: "新細明體", "PMingLiU", monospace; font-size: 13px; background-color: #ffffff;
    border-top: 2px solid #808080; border-left: 2px solid #808080;
    border-right: 2px solid #ffffff; border-bottom: 2px solid #ffffff; padding: 3px 5px;
  }

  /* IE 6.0 模擬工具列與網址列 */
  #ie-toolbar {
    background: #d4d0c8;
    border-bottom: 2px solid #808080;
    padding: 5px 12px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 12px;
  }
  .ie-top-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #333;
    border-bottom: 1px solid #999;
    padding-bottom: 4px;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ie-address-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ie-url-input {
    flex: 1;
    font-family: "Courier New", monospace !important;
    font-size: 13px !important;
    color: #000080;
    padding: 3px 6px !important;
  }

  #wrapper { max-width: 1280px; margin: 10px auto; padding: 0 10px; }

  #site-header {
    background: linear-gradient(90deg, #102a52 0%, #244e8a 65%, #3a6ea5 100%);
    color: #ffffff; border: 2px solid #0a1b36; margin-bottom: 8px;
    transition: background 1s ease;
  }
  body.stage-3 #site-header {
    background: linear-gradient(90deg, #16141c 0%, #2b1d24 65%, #3d2222 100%);
  }

  .header-top { display: flex; align-items: center; padding: 12px 18px; gap: 15px; }
  .school-emblem {
    width: 64px; height: 64px; background: #f4f1e6; border: 2px solid #c5b358;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .school-title h1 {
    margin: 0; font-size: 24px; letter-spacing: 4px; text-shadow: 2px 2px 0px #09172e; font-weight: bold;
  }
  .school-title p {
    margin: 3px 0 0 0; font-size: 12px; font-family: "Courier New", monospace; color: #d0e1f9; letter-spacing: 1px;
  }
  .header-meta {
    margin-left: auto; text-align: right; font-size: 12px; color: #e6eef8; font-family: "細明體", monospace;
  }

  .marquee-bar {
    background: #e9e6da; color: #1a3b6e; border-top: 1px solid #808080; padding: 3px 8px; font-size: 13px;
    display: flex; align-items: center;
  }
  .marquee-label {
    background: #1a3b6e; color: #fff; padding: 1px 6px; font-size: 12px; margin-right: 8px; white-space: nowrap;
  }
  .marquee-text { overflow: hidden; white-space: nowrap; width: 100%; }
  .marquee-inner { display: inline-block; padding-left: 100%; animation: marqueeAnim 35s linear infinite; }
  @keyframes marqueeAnim { 0% { transform: translate(0, 0); } 100% { transform: translate(-100%, 0); } }

  #main-grid { display: grid; grid-template-columns: 210px 1fr 285px; gap: 10px; align-items: start; }

  .panel {
    background-color: var(--bg-panel); border: 1px solid #7f7c70; box-shadow: 2px 2px 0px rgba(0,0,0,0.15);
  }
  .panel-header {
    background-color: var(--nav-blue); color: #ffffff; font-weight: bold; padding: 5px 10px; font-size: 14px; letter-spacing: 1px;
    display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0e2242;
  }
  body.stage-3 .panel-header {
    background-color: #2c1618;
    border-bottom-color: #140808;
  }

  .nav-list { list-style: none; margin: 0; padding: 6px; }
  .nav-item { margin-bottom: 4px; }
  .nav-btn {
    width: 100%; text-align: left; padding: 5px 8px; background: #e2dfd3;
    border-top: 2px solid #ffffff; border-left: 2px solid #ffffff;
    border-right: 2px solid #7a776c; border-bottom: 2px solid #7a776c;
    font-size: 13px; color: #102a52; font-weight: bold; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between;
  }
  .nav-btn:hover { background: #d2deee; color: #000080; }
  .nav-btn.active {
    background: #1a3b6e; color: #ffffff;
    border-top: 2px solid #0c1d38; border-left: 2px solid #0c1d38;
    border-right: 2px solid #5c85c4; border-bottom: 2px solid #5c85c4;
  }

  .counter-box {
    margin: 6px; padding: 7px; background: #e9e6da; border: 1px inset #999; text-align: center; font-size: 12px;
  }
  .led-counter {
    background: #000000; color: #33ff33; font-family: "Courier New", monospace;
    font-weight: bold; font-size: 15px; padding: 2px 8px; letter-spacing: 3px; border: 2px inset #666; display: inline-block; margin: 4px 0;
  }

  #center-content {
    padding: 15px; min-height: 720px; background-color: #f7f5ec;
    background-image: linear-gradient(to bottom, rgba(0,0,0,0.02) 1px, transparent 1px); background-size: 100% 24px;
    position: relative;
  }

  .breadcrumb {
    font-size: 12px; color: #555; border-bottom: 1px dashed #999; padding-bottom: 6px; margin-bottom: 12px;
    display: flex; justify-content: space-between;
  }
  .page-title {
    font-size: 19px; color: #1a3b6e; border-left: 5px solid #1a3b6e; padding-left: 10px;
    margin: 0 0 12px 0; background: #eae6d7; padding-top: 4px; padding-bottom: 4px;
  }

  table.retro-table { width: 100%; border-collapse: collapse; margin: 10px 0; background: #ffffff; font-size: 13px; }
  table.retro-table th { background: #2b4c7e; color: #ffffff; border: 1px solid #666666; padding: 6px 8px; text-align: left; }
  table.retro-table td { border: 1px solid #888888; padding: 6px 8px; vertical-align: top; }
  table.retro-table tr:nth-child(even) td { background: #f4f2ea; }
  table.retro-table tr:hover td { background: #e6eef8; }

  .doc-link {
    color: #0000cc; text-decoration: underline; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
    font-weight: bold; background: none; border: none; padding: 2px 0; font-size: 13.5px; text-align: left;
  }
  .doc-link:hover { color: #990000; background: #fff9d6; }
  .doc-link.read { color: #551a8b; }

  .warn-box {
    background: #fdf2f2; border: 1px solid #990000; border-left: 5px solid #990000; color: #7a0000; padding: 10px 12px; margin: 12px 0; font-size: 13px;
  }
  .info-box {
    background: #eef3fa; border: 1px solid #336699; border-left: 5px solid #1a3b6e; color: #102a52; padding: 10px 12px; margin: 12px 0; font-size: 13px;
  }
  .form-box {
    background: #e6e2d3; border: 2px ridge #888888; padding: 14px; margin: 16px 0;
  }
  .form-box h4 { margin: 0 0 8px 0; color: #1a3b6e; font-size: 15px; border-bottom: 1px solid #aaa; padding-bottom: 4px; }

  /* 原始碼與假後台 DOM 屬性修改器樣式 */
  .source-code-box {
    background: #ffffff;
    color: #000080;
    font-family: "Courier New", "細明體", monospace;
    font-size: 12.5px;
    line-height: 1.55;
    padding: 12px;
    border: 2px inset #808080;
    white-space: pre-wrap;
    overflow-x: auto;
  }
  .html-comment { color: #008000; font-weight: bold; }
  .html-ghost-comment { color: #990000; font-weight: bold; background: #fff0f0; }

  .dom-editor-textarea {
    width: 100%;
    height: 185px;
    background: #101820;
    color: #9cdcfe;
    font-family: "Courier New", monospace;
    font-size: 12.5px;
    line-height: 1.5;
    padding: 10px;
    border: 2px inset #555;
    resize: vertical;
  }

  #right-panel { font-size: 13px; }
  .notebook-section { padding: 8px 10px; border-bottom: 1px solid #c5c1b4; }
  .notebook-title { font-weight: bold; color: #1a3b6e; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; }
  .clue-list, .doc-history-list { list-style: none; margin: 0; padding: 0; max-height: 230px; overflow-y: auto; }
  .clue-item { background: #fffdf5; border: 1px solid #ccc6b4; padding: 5px 7px; margin-bottom: 5px; font-size: 12px; line-height: 1.45; }
  .clue-item.new-clue { border-left: 3px solid #990000; background: #fff8f6; }

  .sys-log-box {
    background: #141414; color: #33ff33; font-family: "Courier New", monospace; font-size: 11px;
    padding: 7px; height: 125px; overflow-y: auto; border: 2px inset #555; line-height: 1.4;
  }
  .sys-log-box .err { color: #ff4d4d; }
  .sys-log-box .warn { color: #ffcc00; }

  #doc-modal-backdrop {
    display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.55); z-index: 9000; align-items: center; justify-content: center;
  }
  #doc-window {
    width: 730px; max-width: 92vw; max-height: 86vh; background: #d4d0c8;
    border-top: 2px solid #ffffff; border-left: 2px solid #ffffff; border-right: 2px solid #404040; border-bottom: 2px solid #404040;
    box-shadow: 6px 6px 0px rgba(0,0,0,0.45); display: flex; flex-direction: column;
    transition: transform 0.15s ease;
  }
  .win-titlebar {
    background: linear-gradient(90deg, #0a246a, #a6caf0); color: #ffffff; font-weight: bold; padding: 4px 8px;
    display: flex; justify-content: space-between; align-items: center; font-size: 13px;
  }
  .win-close-btn { background: #d4d0c8; color: #000; font-weight: bold; padding: 0 6px; font-size: 12px; line-height: 18px; cursor: pointer; }
  .win-menubar { background: #d4d0c8; border-bottom: 1px solid #808080; padding: 2px 8px; font-size: 12px; color: #222; display: flex; gap: 14px; }
  .win-body { background: #fbf9f1; margin: 6px; padding: 18px 22px; border: 2px inset #808080; overflow-y: auto; font-size: 14px; line-height: 1.78; color: #1a1a1a; }
  .doc-meta-header { border-bottom: 2px double #666; padding-bottom: 8px; margin-bottom: 14px; font-size: 13px; color: #444; background: #f2efe4; padding: 8px 10px; }
  .win-footer { padding: 6px 10px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; background: #d4d0c8; border-top: 1px solid #fff; }

  #alert-modal-backdrop {
    display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.45); z-index: 9500; align-items: center; justify-content: center;
  }
  #alert-window {
    width: 440px; max-width: 90vw; background: #d4d0c8; border-top: 2px solid #fff; border-left: 2px solid #fff; border-right: 2px solid #404040; border-bottom: 2px solid #404040; box-shadow: 5px 5px 0px rgba(0,0,0,0.45);
  }
  .alert-content { padding: 16px; display: flex; gap: 14px; align-items: flex-start; font-size: 13px; line-height: 1.6; }
  .alert-icon { width: 34px; height: 34px; background: #1a3b6e; color: #fff; font-weight: bold; font-size: 20px; display: flex; align-items: center; justify-content: center; border: 2px outset #fff; flex-shrink: 0; }

  .cascade-popup {
    position: fixed;
    width: 310px;
    background: #d4d0c8;
    border: 2px outset #fff;
    box-shadow: 4px 4px 0 #000;
    z-index: 9700;
    font-size: 13px;
  }

  /* 相片網格（純寫實存檔） */
  .photo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin: 12px 0; }
  .photo-card { background: #fff; border: 1px solid #888; padding: 8px; text-align: center; box-shadow: 2px 2px 0 #ccc; }
  .retro-photo-frame { position: relative; width: 100%; height: 180px; background: #111; border: 2px inset #666; overflow: hidden; cursor: pointer; }
  .retro-photo-frame img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.08) sepia(0.18) saturate(0.88); transition: transform 0.25s ease; }
  .retro-photo-frame:hover img { transform: scale(1.03); }
  .photo-timestamp {
    position: absolute; bottom: 6px; right: 8px; font-family: "Courier New", monospace; font-size: 11px; font-weight: bold; color: #ff8800; text-shadow: 1px 1px 0 #000; letter-spacing: 1px; pointer-events: none;
  }

  #photo-zoom-backdrop {
    display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.82); z-index: 9600; align-items: center; justify-content: center;
  }
  #photo-zoom-box { background: #d4d0c8; border: 2px outset #fff; padding: 6px; max-width: 90vw; width: 660px; }

  .campus-map-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
  .map-zone-btn { padding: 12px 8px; background: #f4f1e6; border: 2px outset #fff; text-align: center; cursor: pointer; font-weight: bold; color: #1a3b6e; }
  .map-zone-btn:hover { background: #e1ebf7; }

  .pixel-canvas-box { background: #eeeae0; border: 2px inset #888; padding: 10px; margin: 10px 0; text-align: center; }
  .seat-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; max-width: 490px; margin: 10px auto; }
  .seat-cell { background: #ffffff; border: 1px solid #666; padding: 5px 3px; font-size: 12px; text-align: center; }
  .seat-cell.empty-seat { background: #d8d4c8; color: #666; border: 1px dashed #666; }
  .seat-cell.ghost-seat { background: #ece8dc; border: 1px dashed #555; color: #444; }
  body.stage-3 .seat-cell.ghost-seat { background: #f5dada; border: 1px solid #990000; color: #990000; font-weight: bold; }

  .bbs-post { background: #ffffff; border: 1px solid #888; margin-bottom: 10px; }
  .bbs-header { background: #dce3ee; border-bottom: 1px solid #999; padding: 4px 10px; font-size: 12px; display: flex; justify-content: space-between; color: #102a52; }
  .bbs-body { padding: 8px 12px; font-size: 13.5px; }

  .creepy-handwriting {
    font-family: "標楷體", "DFKai-SB", "Noto Serif TC", serif;
    color: #5c0000; background: #f9efef; border-left: 3px solid #800000; padding: 10px 14px; margin: 10px 0; letter-spacing: 0.5px;
  }

  @keyframes rowIntrude {
    0% { background-color: #ffcccc; transform: translateX(-3px); }
    50% { background-color: #ffe6e6; transform: translateX(3px); }
    100% { background-color: #fdf0f0; transform: translateX(0); }
  }
  .intruder-row td {
    background-color: #fdf0f0 !important;
    color: #990000 !important;
    font-weight: bold;
    border-color: #990000 !important;
    animation: rowIntrude 0.25s ease-in-out 2;
  }

  #ending-overlay {
    display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: 9900; overflow-y: auto; padding: 30px 20px; transition: background 1.5s ease;
  }
  #ending-overlay.ending-bad { background: radial-gradient(circle at center, #1a0000 0%, #000000 85%); color: #e6dcdc; }
  .bad-ending-box {
    max-width: 760px; margin: 10px auto; border: 2px solid #660000; background: rgba(12, 2, 2, 0.94);
    padding: 32px; line-height: 1.95; box-shadow: 0 0 40px rgba(180, 0, 0, 0.35); position: relative;
