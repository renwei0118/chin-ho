function updateNotebookUI() {
  const clueList = document.getElementById("ui-clue-list");
  document.getElementById("clue-count").textContent = gameState.clues.length;
  if (gameState.clues.length === 0) {
    clueList.innerHTML = `<li class="clue-item" style="color:#666;">（尚無紀錄）</li>`;
  } else {
    clueList.innerHTML = gameState.clues.slice().reverse().map(c => `<li class="clue-item new-clue">${wrapName(c.text)}</li>`).join("");
  }

  const docList = document.getElementById("ui-doc-list");
  document.getElementById("doc-count").textContent = gameState.readDocs.length;
  if (gameState.readDocs.length === 0) {
    docList.innerHTML = `<li class="clue-item" style="color:#666;">（尚無紀錄）</li>`;
  } else {
    docList.innerHTML = gameState.readDocs.map(id => {
      const d = DOCUMENTS[id];
      return `<li class="clue-item" style="cursor:pointer;" onclick="openDocument('${id}')"><strong>${d.filename}</strong></li>`;
    }).join("");
  }
}

