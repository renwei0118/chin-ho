function renderLibraryTable(books) {
  if (books.length === 0) return `<div class="warn-box">查無符合條件的館藏或借閱紀錄。</div>`;
  return `
    <table class="retro-table">
      <tr><th>索書號</th><th>書名</th><th>作者</th><th>借閱狀態 / 登記證號</th></tr>
      ${books.map(b => `
        <tr style="${b.hidden ? 'background:#fff8f6;' : ''}">
          <td><code>${b.callNo}</code></td>
          <td><strong>${b.title}</strong></td>
          <td>${b.author}</td>
          <td>${b.status}<br><span style="font-size:12px; color:#555;">借書證號：${b.cardId} ${b.date ? `(${b.date})` : ""}</span></td>
        </tr>
      `).join("")}
    </table>
  `;
}

function searchLibrary() {
  const q = (document.getElementById("lib-query-input").value || "").trim().toLowerCase();
  const wrap = document.getElementById("lib-table-wrap");
  if (!q) { wrap.innerHTML = renderLibraryTable(LIBRARY_BOOKS.filter(b => !b.hidden)); return; }

  const matched = LIBRARY_BOOKS.filter(b =>
    b.callNo.toLowerCase().includes(q) ||
    b.title.toLowerCase().includes(q) ||
    b.cardId.toLowerCase() === q
  );
  if (q === "2032") {
    addClue({ id: "clue_lib_search_2032", text: "【館藏檢索】輸入證號 2032 調出了三筆離線手寫借書紀錄：《基礎鉛筆素描技法》、《如何交到好朋友》、《被遺忘的角落》。" });
  }
  wrap.innerHTML = renderLibraryTable(matched);
}

